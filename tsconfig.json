{
  "extends": "../deepseek-harness/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictFunctionTypes": false,
    "noImplicitOverride": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "typeRoots": [
      "./node_modules/@types",
      "../deepseek-harness/node_modules/@types"
    ],
    "paths": {
      "@deepseek-ai/cordis": ["../deepseek-harness/vendor/cordis/src"],
      "@deepseek-ai/cosmokit": ["../deepseek-harness/vendor/cosmokit/src"],
      "@deepseek-ai/schemastery": ["../deepseek-harness/vendor/schemastery/src"],
      "@deepseek-ai/dsh-llm": ["../deepseek-harness/packages/llm/llm/src"],
      "@deepseek-ai/dsh-llm/types": ["../deepseek-harness/packages/llm/llm/src/types.ts"],
      "@deepseek-ai/dsh-llm/brand": ["../deepseek-harness/packages/llm/llm/src/brand.ts"],
      "@deepseek-ai/dsh-llm/message": ["../deepseek-harness/packages/llm/llm/src/message.ts"],
      "@deepseek-ai/dsh-llm/assistant-stream": ["../deepseek-harness/packages/llm/llm/src/assistant-stream.ts"],
      "@deepseek-ai/dsh-tools": ["../deepseek-harness/packages/core/tools/src"],
      "@deepseek-ai/dsh-tools/pipeline": ["../deepseek-harness/packages/core/tools/src/pipeline.ts"],
      "@deepseek-ai/dsh-tools/presentation": ["../deepseek-harness/packages/core/tools/src/presentation.ts"],
      "@deepseek-ai/dsh-session": ["../deepseek-harness/packages/core/session/src"],
      "@deepseek-ai/dsh-session/types": ["../deepseek-harness/packages/core/session/src/types.ts"],
      "@deepseek-ai/dsh-session/chunk-rows": ["../deepseek-harness/packages/core/session/src/chunk-rows.ts"],
      "@deepseek-ai/dsh-session/surface": ["../deepseek-harness/packages/core/session/src/surface.ts"],
      "@deepseek-ai/dsh-session/fork": ["../deepseek-harness/packages/core/session/src/fork.ts"],
      "@deepseek-ai/dsh-subagent": ["../deepseek-harness/packages/subagent/subagent/src"],
      "@deepseek-ai/dsh-subagent/client": ["../deepseek-harness/packages/subagent/subagent/src/client.ts"],
      "@deepseek-ai/dsh-subagent/internal": ["../deepseek-harness/packages/subagent/subagent/src/internal.ts"],
      "@deepseek-ai/dsh-brand": ["../deepseek-harness/packages/util/brand/src"],
      "@deepseek-ai/dsh-util-crypto": ["../deepseek-harness/packages/util/crypto/src"],
      "@deepseek-ai/dsh-util-values": ["../deepseek-harness/packages/util/values/src"],
      "@deepseek-ai/dsh-util-workspace-path": ["../deepseek-harness/packages/util/workspace-path/src/index.ts"],
      "@deepseek-ai/dsh-timeout": ["../deepseek-harness/packages/util/timeout/src"],
      "@deepseek-ai/dsh-typert-protocol": ["../deepseek-harness/packages/typert/protocol/src/index.ts"],
      "@deepseek-ai/dsh-typert-protocol/types": ["../deepseek-harness/packages/typert/protocol/src/types.ts"],
      "@deepseek-ai/dsh-typert-protocol/remote-info": ["../deepseek-harness/packages/typert/protocol/src/remote-info.ts"],
      "@deepseek-ai/dsh-attachment": ["../deepseek-harness/packages/attachment/attachment/src"],
      "@deepseek-ai/dsh-attachment/types": ["../deepseek-harness/packages/attachment/attachment/src/types.ts"],
      "@deepseek-ai/dsh-scope": ["../deepseek-harness/packages/core/scope/src"],
      "@deepseek-ai/dsh-workspace": ["../deepseek-harness/packages/workspace/workspace/src"],
      "@deepseek-ai/dsh-workspace/types": ["../deepseek-harness/packages/workspace/workspace/src/types.ts"],
      "@deepseek-ai/dsh-fs": ["../deepseek-harness/packages/fs/fs/src"],
      "@deepseek-ai/dsh-sandbox": ["../deepseek-harness/packages/sandbox/sandbox/src"],
      "@deepseek-ai/dsh-system-prompt": ["../deepseek-harness/packages/core/system-prompt/src"],
      "@deepseek-ai/dsh-invariants": ["./packages/ambient.d.ts"],
      "@deepseek-ai/dsh-client-*": ["./packages/ambient.d.ts"],
      "@deepseek-ai/dsh-client-*/client": ["./packages/ambient.d.ts"]
    }
  },
  "include": [
    "packages/ambient.d.ts",
    "packages/tool-antigravity/src",
    "packages/tool-antigravity/tests",
    "packages/subagent-antigravity-cli/src",
    "packages/subagent-antigravity-cli/tests",
    "packages/mmb-migration-workbench/src",
    "packages/mmb-migration-workbench/tests",
    "packages/llm-ollama/src",
    "packages/llm-ollama/tests"
  ]
}
